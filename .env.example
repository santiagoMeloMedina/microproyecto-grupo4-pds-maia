# Plantilla de configuracion local. Copiar a `.env` en la raiz del repositorio
# y ajustar los valores. `.env` esta en .gitignore, asi que la IP de cada quien
# no viaja al repositorio compartido.
#
#     cp .env.example .env
#
# Las variables ya definidas en el entorno tienen precedencia sobre este archivo.

# Servidor de seguimiento de MLflow.
# - Sin definir  -> SQLite local en mlflow.db
# - Con la IP    -> consolida los experimentos en la instancia EC2 del equipo
# Ver docs/2nd_delivery/mlflow_ec2.md para el montaje del servidor.
MLFLOW_TRACKING_URI=http://TU_IP_PUBLICA_EC2:5000

# Ruta alterna al dataset, si no esta en data/airlines.csv
# AIRLINES_CSV=
